# Keep LF endings everywhere. The notes are written by Obsidian and by scripts that
# emit LF; letting Windows git rewrite them to CRLF on checkout would show every file
# as modified after a clone and make diffs useless.
*.md      text eol=lf
*.txt     text eol=lf
*.json    text eol=lf
*.py      text eol=lf
*.ipynb   text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf

# Anything the cluster executes. Slurm refuses a batch script containing CRLF
# outright ("Batch script contains DOS line breaks"), and bash silently appends the
# \r to the last argument of every line, so a shell script that survives the check
# fails later in ways that are hard to read. These two lines were missing until
# 8 September 2026, which is why every .sbatch in the repo was CRLF.
*.sbatch  text eol=lf
*.sh      text eol=lf

# Binaries - never touch these
*.pdf     binary
*.docx    binary
*.png     binary
*.jpg     binary
